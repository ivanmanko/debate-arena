# --- LLM providers (ADR-001). Set the key for the provider your models use. ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Model strings are "provider/model". Supported providers: anthropic, deepseek, mock.
# Defaults mirror SPEC §7.
# MODEL_ANALYST=anthropic/claude-opus-5-5
# MODEL_JUDGE=anthropic/claude-opus-5-5
# DeepSeek alternative:
# MODEL_ANALYST=deepseek/deepseek-chat
# MODEL_JUDGE=deepseek/deepseek-chat

# Anthropic: thinking is always on for Opus 5.5; effort is the only depth control.
# ANALYST_EFFORT=medium
# JUDGE_EFFORT=high
# DeepSeek sampling (Anthropic ignores temperature).
# DEEPSEEK_TEMPERATURE=0.3

# Force the mock engine (no LLM calls). Auto-on if the selected provider has no key.
# MOCK_LLM=0

# --- Analysis shape (SPEC §7) ---
# DEFAULT_ROUNDS=2
# MAX_ROUNDS=3
# MAX_TEXT_CHARS=200000
# Prompt caching (Anthropic): TTL блока с материалом у аналитиков и в чате с судьёй
# CACHE_TTL_ANALYSIS=5m
# CACHE_TTL_CHAT=1h
# Отказ модели: перезапуск на рекомендованной Anthropic резервной модели (SPEC §4.9)
# REFUSAL_FALLBACK=true
# TURN_MAX_TOKENS=6000
# JUDGE_MAX_TOKENS=16000
# LANGUAGE=русский

# --- Judge chat: discussing the verdict (SPEC §4.6) ---
# JUDGE_CHAT_EFFORT=medium
# JUDGE_CHAT_MAX_TOKENS=6000
# JUDGE_CHAT_MAX_CHARS=2000
# JUDGE_CHAT_MAX_MESSAGES=20
# JUDGE_CHAT_TIMEOUT_S=180


# --- Storage. Local default is SQLite; docker-compose overrides with Postgres. ---
# DATABASE_URL=sqlite+aiosqlite:///./debate_arena.db

# --- Web ---
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
# Public address of the web UI: links from the bot and local snapshot links.
# PUBLIC_URL=

# --- Public snapshots (SPEC §4.7, ADR-006) ---
# GCS bucket readable by allUsers (roles/storage.legacyObjectReader). Empty → files in
# SHARE_DIR, served by the app at /shared/ (links use PUBLIC_URL when it is set).
# SHARE_BUCKET=
# SHARE_DIR=./shared
# SHARE_TOKEN_BYTES=16
# SHARE_CACHE_MAX_AGE_S=60

# --- Telegram bot (optional second interface) ---
BOT_TOKEN=
