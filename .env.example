# --- Telegram ---
BOT_TOKEN=

# --- Storage ---
# Local default (zero infra). For Postgres use e.g.:
# DATABASE_URL=postgresql+asyncpg://debate:debate@localhost:5432/debate
DATABASE_URL=sqlite+aiosqlite:///./debate_arena.db

# --- Local Ollama (no key). LiteLLM reads OLLAMA_API_BASE from the environment. ---
# Use models like ollama/llama3 in the MODEL_* settings below.
# OLLAMA_API_BASE=http://localhost:11434

# --- Provider keys (LiteLLM picks these up). Set the ones your personas use. ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Per-slot models (LiteLLM strings). Override to repoint a voice. ---
MODEL_RADICAL=deepseek/deepseek-chat
MODEL_SKEPTIC=gemini/gemini-2.0-flash
MODEL_QUESTIONER=openai/gpt-4o-mini
MODEL_JUDGE=openrouter/anthropic/claude-3.5-haiku

# --- Language personas & judge must write in (any name: русский, English, …) ---
LANGUAGE=русский

# --- Debate shape ---
MAX_ROUNDS=3
MAX_PERSONAS=3
TURN_MAX_TOKENS=450
JUDGE_MAX_TOKENS=900
JUDGE_TEMPERATURE=0.3

# --- Pacing (seconds) ---
PAUSE_BETWEEN_TURNS=2.2
PAUSE_AFTER_HEADER=1.2
TYPING_PER_TURN=1.6

# Force the mock engine (no LLM calls). Auto-on if no provider key is set.
MOCK_LLM=0
